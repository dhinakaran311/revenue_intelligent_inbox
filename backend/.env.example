# backend/.env.example

# Application environment (development, test, production)
APP_ENV=development

# Base URL for the API (e.g., http://localhost:8000)
APP_BASE_URL=http://localhost:8000

# Frontend origin allowed for CORS (e.g., http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000

# Supabase configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY   # server‑only, never expose
SUPABASE_ANON_KEY=YOUR_ANON_KEY                # optional, only if needed backend side

# Pinecone configuration (optional at start)
PINECONE_API_KEY=YOUR_PINECONE_API_KEY
PINECONE_INDEX_NAME=volopay-index
PINECONE_NAMESPACE=development

# Groq configuration (optional at start)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=latest-model

# Embedding provider settings (required when retrieval is enabled)
EMBEDDING_PROVIDER=your-provider
EMBEDDING_MODEL=embedding-model-v1

# Export location (local relative path)
EXPORT_ROOT=exports

# Logging level
LOG_LEVEL=info
